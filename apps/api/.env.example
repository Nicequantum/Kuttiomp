# Kuttiomp FastAPI Backend Environment (v0.4)
# Copy to .env in this directory

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CLERK_SECRET_KEY=sk_test_your-key
# Optional issuer / JWKS overrides. Default JWKS is https://api.clerk.com/v1/jwks
# CLERK_JWKS_URL=
# CLERK_ISSUER=
# Flutter FastAPI calls only:
# SUPABASE_JWT_SECRET=
# Local/API tests only — never set in production:
# AUTH_DEV_SECRET=
API_ENV=development

# Grok / xAI — linguistic learning assistance (NOT ceremonial authority)
# Get key: https://console.x.ai → API Keys
# Verify: GET http://localhost:8000/api/grok/test
GROK_API_KEY=xai-your-key
GROK_API_BASE_URL=https://api.x.ai/v1

API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins. Defaults include admin + Learn (local and Vercel).
# Add Vercel preview URLs here if you need them.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://kuttiomp-learn.vercel.app,https://kuttiomp-admin.vercel.app
AUDIO_STORAGE_BUCKET=kuttiomp-audio
AUDIO_MAX_DURATION_SECONDS=300
SACRED_CONTENT_REQUIRES_ELDER_APPROVAL=true
DEFAULT_CONTENT_VISIBILITY=clan